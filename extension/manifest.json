{
  "manifest_version": 3,
  "name": "KaizenFlow Isolation Shield",
  "version": "1.0.0",
  "description": "Hardcore distraction blocker for KaizenFlow. Shuts down Facebook, Instagram, WhatsApp, and social media across all browser tabs while in Isolation Mode.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.whatsapp.com/*",
    "*://web.whatsapp.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.tiktok.com/*",
    "*://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://kaizenflow.study/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KaizenFlow Isolation Shield"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
